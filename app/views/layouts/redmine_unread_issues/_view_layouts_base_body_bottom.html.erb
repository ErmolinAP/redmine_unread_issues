<% if User.current.logged? %>
    <script>
        $(function () {
            var Unrbody = $('body');
            var clR = 'read';
            var clU = 'unread';
            var clUp = 'updated';

            function startTooltip(elem){
                elem.tooltip({
                    position: {
                        my: "right-10 top",
                        at: "right-10 bottom-20"
                    }
                });
            }

            function startFind(elemNew, elemFind){
               if(elemNew.length > 0) {
                   elemNew.each(function(){
                       if($(this).hasClass(clU)) $(this).find(elemFind).prepend(tUnread);
                       if($(this).hasClass(clUp)) $(this).find(elemFind).prepend(tUpdated);
                   })
                   startTooltip(elemNew);
               }
            }

            function startBefore(elemBefore){
                if(elemBefore.length > 0) {
                    elemBefore.each(function(){
                        if($(this).hasClass(clU)) $(this).before(tUnread);
                        if($(this).hasClass(clUp)) $(this).before(tUpdated);
                    })
                    elemBefore(elemThis);
                }
            }

            function startThis(elemThis){
                if(elemThis.length > 0) {
                    elemThis.each(function(){
                        if($(this).hasClass(clU)) $(this).prepend(tUnread);
                        if($(this).hasClass(clUp)) $(this).prepend(tUpdated);
                    })
                    startTooltip(elemThis);
                }
            }

            var tUnread = '<span class="evo-un-el evo-unread" title="<%= t('unread_issues_label_filter_unread') %>"></span>';
            var tUpdated = '<span class="evo-un-el evo-updated" title="<%= t('unread_issues_label_filter_updated') %>"></span>';

            /* -- START CALENDAR DEFAULT -- */
            var elCal = Unrbody.find('.cal div.issue.'+ clR +', .cal div.issue.'+ clU +', .cal div.issue.'+ clUp);
            startThis(elCal);

            /* -- START ISSUE TABLES -- */
            var listTabl = Unrbody.find('tr.'+ clR +', tr.'+ clU +', tr.'+ clUp);
            startFind(listTabl, 'td.subject');

            /* -- START DEFAULT GANTT -- */
            var ganttEl = Unrbody.find('.gantt-table .issue');
            startBefore(ganttEl);

            /* -- START EVO PLUGINS -- */
            var bageTime = Unrbody.find('.revo-item-list > li');
            var bageOld = Unrbody.find('.revo-item-list > .revo-list-i');

            if(bageTime.length > 0){
                if(bageOld.length > 0){
                    startFind(bageOld, '> a');
                }else {
                    startFind(bageTime, '.revo-holder-info');
                }
            }
        })
    </script>
<% end %>
