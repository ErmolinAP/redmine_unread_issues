<% if User.current.logged? %>
  <%
    counters = RedmineUnreadIssues::Counters.for(User.current)
    payload = {
      counters: counters,
      urls: {
        assigned: issues_path(set_filter: 1, f: %w[assigned_to_id status_id],
                              op: { assigned_to_id: '=', status_id: 'o' },
                              v: { assigned_to_id: ['me'] }),
        unread: issues_path(set_filter: 1, f: %w[assigned_to_id read_issue_unread],
                            op: { assigned_to_id: '=', read_issue_unread: '=' },
                            v: { assigned_to_id: ['me'], read_issue_unread: ['1'] }),
        updated: issues_path(set_filter: 1, f: %w[assigned_to_id read_issue_updated],
                             op: { assigned_to_id: '=', read_issue_updated: '=' },
                             v: { assigned_to_id: ['me'], read_issue_updated: ['1'] })
      },
      labels: {
        assigned_hint: l(:unread_issues_hint_counter_assigned),
        unread_hint: l(:unread_issues_hint_counter_unread),
        updated_hint: l(:unread_issues_hint_counter_updated)
      }
    }
  %>
  <script>
    window.RedmineUnreadIssues = <%= raw(payload.to_json) %>;
  </script>
  <script>
    // Счётчики в верхнем меню (аналог сборки support.hostco.ru).
    // Чистый JS: не зависит от порядка загрузки jQuery.
    (function () {
      function build() {
        var data = window.RedmineUnreadIssues;
        var menu = document.querySelector('#top-menu > ul');
        if (!data || !menu) { return; }
        if (menu.querySelector('a.ui-my-assigned-issues')) { return; }

        var myPage = menu.querySelector('a.my-page');
        var anchor = myPage ? myPage.parentNode : (menu.lastElementChild || menu);
        if (!anchor) { return; }

        var items = [
          {cls: 'ui-my-assigned-issues', count: 'count',         n: data.counters.assigned, url: data.urls.assigned, hint: data.labels.assigned_hint},
          {cls: 'ui-my-unread-issues',   count: 'count unread',  n: data.counters.unread,   url: data.urls.unread,   hint: data.labels.unread_hint},
          {cls: 'ui-my-updated-issues',  count: 'count updated', n: data.counters.updated,  url: data.urls.updated,  hint: data.labels.updated_hint}
        ];

        items.reverse().forEach(function (item) {
          var li = document.createElement('li');
          var a = document.createElement('a');
          a.className = item.cls;
          a.href = item.url;
          a.title = item.hint;
          a.setAttribute('aria-label', item.hint);
          var span = document.createElement('span');
          span.className = item.count;
          span.textContent = item.n;
          a.appendChild(span);
          li.appendChild(a);
          if (anchor.parentNode) {
            anchor.parentNode.insertBefore(li, anchor.nextSibling);
          } else {
            anchor.appendChild(li);
          }
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', build);
      } else {
        build();
      }
    })();
  </script>
<% end %>
